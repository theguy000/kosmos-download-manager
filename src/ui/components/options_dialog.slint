import { Palette } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import {
    ComboItem,
    DialogCheckBox,
    DialogComboBox,
    DialogInput,
    DialogSlider,
    FocusStyle,
    PointerButton,
} from "controls.slint";

// One folder row: everything the Save To tab shows and edits, kept together so the category
// name, destination, file types, and enabled state cannot drift apart.
export struct CategoryOption {
    id: int,
    name: string,
    dir: string,
    file_types: string,
    enabled: bool,
}

export component OptionsDialog inherits Rectangle {
    in-out property <int> selected_tab: 0;
    in-out property <bool> launch_on_startup: false;
    in property <bool> startup_option_visible: false;

    // Save To tab. Index 0 is the default directory.
    in-out property <int> save_to_category: 0;
    in-out property <bool> use_kdm_folder: false;
    in-out property <[CategoryOption]> categories: [];
    in property <[ComboItem]> combo_items: [];

    in-out property <float> streams_count: 8;

    private property <[string]> tab_names: [
        "General",
        "File Types",
        "Save To",
        "Downloads",
        "Sound",
        "Proxy",
        "Advanced",
    ];

    private property <bool> startup_stop: root.startup_option_visible && root.selected_tab == 0;
    private property <bool> save_to_tab: root.selected_tab == 2;
    private property <bool> downloads_tab: root.selected_tab == 3;
    private property <int> stop_count: root.startup_stop ? 4
        : (root.save_to_tab ? (root.save_to_category == 0 ? 8 : 9) : (root.downloads_tab ? 4 : 3));

    private property <string> current_category_name:
        root.categories.length > root.save_to_category
            ? root.categories[root.save_to_category].name
            : "";

    private property <int> focus_index: strip_focus.has-focus ? 0
        : (root.startup_stop && startup_box.has-keyboard-focus ? 1
        : (root.save_to_tab && category_combo.has_keyboard_focus ? 1
        : (root.save_to_tab && path_input.has_keyboard_focus ? 2
        : (root.save_to_tab && browse_button.has-keyboard-focus ? 3
        : (root.save_to_tab && reset_button.has-keyboard-focus ? 4
        : (root.save_to_tab && root.save_to_category != 0 && types_input.has-keyboard_focus ? 5
        : (root.save_to_tab && kdm_box.has-keyboard-focus ? (root.save_to_category == 0 ? 5 : 6)
        : (root.downloads_tab && streams_slider.has_keyboard_focus ? 1
        : (ok_button.has-keyboard-focus ? root.stop_count - 2
        : (cancel_button.has-keyboard-focus ? root.stop_count - 1 : -1))))))))));

    private property <bool> keyboard_focused: false;

    callback dismiss(bool);
    callback confirm(bool);
    callback browse_category_folder(int);
    callback reset_category_default(int);
    callback default_dir_edited(string, string);
    callback toggle_category_list(int);
    callback toggle_kdm_folder(bool);

    function sync_to_input() {
        if root.categories.length == 0 { return; }
        path_input.text = root.categories[root.save_to_category].dir;
        types_input.text = root.categories[root.save_to_category].file_types;
    }

    function focus-item(index: int) {
        root.keyboard_focused = index == 0;
        if index == 0 { strip_focus.focus(); }
        else if root.startup_stop && index == 1 { startup_box.take-focus(); }
        else if root.save_to_tab && index == 1 { category_combo.take-focus(); }
        else if root.save_to_tab && index == 2 { path_input.take-focus(); }
        else if root.save_to_tab && index == 3 { browse_button.take-focus(); }
        else if root.save_to_tab && index == 4 { reset_button.take-focus(); }
        else if root.save_to_tab && root.save_to_category != 0 && index == 5 { types_input.take-focus(); }
        else if root.save_to_tab && ((root.save_to_category == 0 && index == 5) || (root.save_to_category != 0 && index == 6)) { kdm_box.take-focus(); }
        else if root.downloads_tab && index == 1 { streams_slider.take-focus(); }
        else if index == root.stop_count - 2 { ok_button.take-focus(); }
        else { cancel_button.take-focus(); }
    }

    changed categories => { root.sync_to_input(); }
    changed save_to_category => { root.sync_to_input(); }
    changed selected_tab => { content_scroll.content-y = 0; }

    background: Palette.overlay;
    forward-focus: dialog_focus;
    init => { dialog_focus.focus(); }

    TouchArea {}

    dialog_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss(true);
                return accept;
            }
            if event.text == Key.Tab {
                root.focus-item(event.modifiers.shift
                    ? (root.focus_index <= 0 ? root.stop_count - 1 : root.focus_index - 1)
                    : (root.focus_index < 0 ? 0 : mod(root.focus_index + 1, root.stop_count)));
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.keyboard_focused = true;
                root.selected_tab = max(0, root.selected_tab - 1);
                strip_focus.focus();
                return accept;
            }
            if event.text == Key.RightArrow {
                root.keyboard_focused = true;
                root.selected_tab = min(root.tab_names.length - 1, root.selected_tab + 1);
                strip_focus.focus();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 560px;
            height: 380px;
            background: Palette.surface;
            accessible-role: groupbox;
            accessible-label: "Options";

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Header
                HorizontalLayout {
                    height: 24px;

                    Text {
                        text: "Options";
                        font-size: 15px;
                        font-weight: 600;
                        color: Palette.text-primary;
                        vertical-alignment: center;
                    }
                }

                // Tab strip
                Rectangle {
                    height: 32px;
                    background: Palette.background;

                    // Top and bottom borders for the strip
                    Rectangle { y: 0px; height: 1px; background: Palette.border; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }

                    HorizontalLayout {
                        spacing: 0px;

                        for name[index] in root.tab_names: Rectangle {
                            horizontal-stretch: 1;
                            background: root.selected_tab == index ? Palette.border : (tab_touch.has-hover ? Palette.surface-alt : transparent);
                            border-width: strip_focus.has-focus && root.keyboard_focused && root.selected_tab == index ? 1px : 0px;
                            border-color: FocusStyle.ring;
                            accessible-role: button;
                            accessible-label: name;
                            accessible-enabled: true;
                            accessible-action-default => { root.selected_tab = index; }

                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: name;
                                font-size: 11px;
                                font-weight: 400;
                                color: root.selected_tab == index ? Palette.accent-text : (tab_touch.has-hover ? Palette.text-secondary : Palette.text-muted);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // Full-height 1px column divider between tabs
                            if index < root.tab_names.length - 1 && root.selected_tab != index: Rectangle {
                                x: parent.width - 1px;
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Palette.border;
                            }

                            if root.selected_tab == index: Rectangle {
                                x: 0px;
                                y: parent.height - 2px;
                                width: parent.width;
                                height: 2px;
                                background: Palette.accent;
                            }

                            tab_touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected_tab = index;
                                    root.keyboard_focused = false;
                                    strip_focus.focus();
                                }
                            }
                        }
                    }

                    // One tab stop for the strip; keys bubble to the dialog scope, which owns
                    // Tab (focus cycle) and the arrow keys (tab selection).
                    strip_focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        key-pressed(event) => { return reject; }
                    }
                }

                // Tab content
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.background;

                    content_scroll := ScrollView {
                        VerticalLayout {
                            visible: root.selected_tab == 0;
                            alignment: start;
                            padding: 16px;
                            spacing: 8px;

                            startup_box := DialogCheckBox {
                                visible: root.startup_stop;
                                checked <=> root.launch_on_startup;
                                text: "Launch Kosmos Download Manager on startup";
                            }
                        }

                    VerticalLayout {
                        visible: root.selected_tab == 2;
                        alignment: start;
                        padding: 16px;
                        spacing: 12px;

                        // Category selector row
                        HorizontalLayout {
                            spacing: 12px;
                            height: 32px;

                            Text {
                                text: "Category:";
                                width: 70px;
                                font-size: 12px;
                                color: Palette.text-muted;
                                vertical-alignment: center;
                            }

                            category_combo := DialogComboBox {
                                width: 200px;
                                label: "Category";
                                current_index <=> root.save_to_category;
                                items: root.combo_items;
                                item_action_clicked(index) => {
                                    if index > 0 && index < root.categories.length {
                                        root.toggle_category_list(root.categories[index].id);
                                    }
                                }
                                item_action_shortcut(index, key) => {
                                    if index <= 0 || index >= root.categories.length { return false; }
                                    if root.categories[index].enabled {
                                        if key == Key.Delete {
                                            root.toggle_category_list(root.categories[index].id);
                                            return true;
                                        }
                                    } else if key == "+" {
                                        root.toggle_category_list(root.categories[index].id);
                                        return true;
                                    }
                                    return false;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }

                        // Directory label
                        Text {
                            text: root.save_to_category == 0
                                ? "Default download directory:"
                                : "Default download directory for \"" + root.current_category_name + "\" category:";
                            font-size: 11px;
                            color: Palette.text-muted;
                        }

                        // Directory input row
                        HorizontalLayout {
                            spacing: 8px;
                            height: 36px;

                            path_input := DialogInput {
                                text: root.categories[root.save_to_category].dir;
                                label: "Download directory";
                                edited(text) => {
                                    // The old default is captured before the write so Rust can
                                    // cascade category subfolders from it.
                                    let old_default = root.categories[0].dir;
                                    root.categories[root.save_to_category].dir = text;
                                    if root.save_to_category == 0 {
                                        root.default_dir_edited(old_default, text);
                                    }
                                }
                            }

                            browse_button := PointerButton {
                                text: "Browse";
                                filled: true;
                                clicked => {
                                    root.browse_category_folder(root.categories[root.save_to_category].id);
                                }
                            }

                            reset_button := PointerButton {
                                text: "Default";
                                filled: true;
                                clicked => {
                                    root.reset_category_default(root.categories[root.save_to_category].id);
                                }
                            }
                        }

                        // File types row. General catches everything else, so it has no list.
                        HorizontalLayout {
                            spacing: 12px;
                            height: 36px;

                            Text {
                                text: "File types:";
                                width: 70px;
                                font-size: 12px;
                                color: Palette.text-muted;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;

                                types_input := DialogInput {
                                    width: 100%;
                                    height: 100%;
                                    visible: root.save_to_category != 0;
                                    text: root.categories[root.save_to_category].file_types;
                                    label: "File types";
                                    placeholder-text: "e.g. zip, rar, 7z";
                                    edited(text) => {
                                        root.categories[root.save_to_category].file_types = text;
                                    }
                                }

                                Text {
                                    x: 0px;
                                    width: 100%;
                                    height: 100%;
                                    visible: root.save_to_category == 0;
                                    text: "All other file types";
                                    font-size: 12px;
                                    color: Palette.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        kdm_box := DialogCheckBox {
                            checked <=> root.use_kdm_folder;
                            text: "Route downloads to KDM folder";
                            changed checked => {
                                root.toggle_kdm_folder(self.checked);
                            }
                        }
                    }

                    VerticalLayout {
                        visible: root.selected_tab == 3;
                        alignment: start;
                        padding: 16px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 12px;

                            Text { text: "Connections:"; width: 85px; font-size: 12px; color: Palette.text-muted; vertical-alignment: center; }
                            streams_slider := DialogSlider {
                                value <=> root.streams_count;
                            }
                            Text {
                                text: Math.round(root.streams_count) + " per download";
                                width: 100px; font-size: 12px; color: Palette.text-muted; vertical-alignment: center;
                            }
                        }
                    }
                }
            }

                // Footer actions
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }

                    ok_button := PointerButton {
                        text: "OK";
                        primary: true;
                        clicked(from_keyboard) => {
                            root.confirm(from_keyboard);
                        }
                    }

                    cancel_button := PointerButton {
                        text: "Cancel";
                        clicked(from_keyboard) => { root.dismiss(from_keyboard); }
                    }
                }
            }
        }
    }
}
