import { Palette } from "theme.slint";
import { Navigation } from "navigation.slint";

export component StatusFooter inherits Rectangle {
    in property <int> selected_category: 0;
    in property <bool> active_row_visible: false;
    in property <int> total_items: 0;
    in property <bool> is_downloading: false;
    in property <string> active_transfer_rate: "0 KB/s";
    in property <float> streams_count: 8;

    height: 22px;
    background: Palette.background;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        Text {
            text: (root.selected_category == Navigation.unfinished ? (root.active_row_visible ? "1 unfinished item" : "0 unfinished items") :
                root.total_items + (root.total_items == 1 ? " total item" : " total items")) + " | " +
                (root.is_downloading ? "1 active download" : "Idle");
            font-size: 11px;
            color: Palette.text-faint;
            vertical-alignment: center;
        }

        Rectangle {}

        Text {
            text: "Transfer: " + (root.is_downloading ? root.active_transfer_rate : "0 KB/s") + " | Connections: " + Math.round(root.streams_count);
            font-size: 11px;
            color: Palette.text-faint;
            vertical-alignment: center;
        }
    }
}
